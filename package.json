{
  "name": "cindy-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run build && tsx server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node server-dist/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/smoke-runtime.mjs",
    "test:all": "npm run test:coverage && npm run build && npm run test:integration",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/check-docs.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dco:install-hook": "node scripts/install-dco-hook.mjs",
    "check:dco": "node scripts/check-dco.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run docs:check && npm run test:coverage && npm run build && npm run test:integration"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.5"
  }
}
